# Copy this file to .env and fill in your own values.
# .env is in .gitignore, so your keys never go to GitHub.

# --- Meta Model API (create a key at dev.meta.ai > API keys) ---
META_API_KEY=
META_API_BASE_URL=https://api.meta.ai/v1
# Don't use the "-contributor" models: they let Meta train on prompts,
# and TrueTick users send private messages.
TEXT_MODEL=muse-spark-1.3
VISION_MODEL=muse-spark-1.3
SEGMENT_MODEL=sam-3.1
TRANSCRIBE_MODEL=muse-voice-transcribe-1.0
IMAGE_MODEL=muse-image-1.0

# --- App ---
MAX_UPLOAD_MB=16
